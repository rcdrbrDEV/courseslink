                </div>
            </div>

            <!-- Register Form -->
            <div id="form-register" class="hidden">
                <h3 class="text-2xl font-bold text-white mb-2">Criar conta grátis</h3>
                <p class="text-slate-400 text-sm mb-6">Comece a monetizar em minutos</p>

                <form onsubmit="handleEmailRegister(event)" class="space-y-4">
                    <div>
                        <label class="text-xs font-semibold text-slate-300 block mb-1">E-mail</label>
                        <input type="email" id="reg-email" required placeholder="seu@email.com" class="w-full bg-dark-900 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-brand-500 text-sm">
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-300 block mb-1">Senha (mín. 6 caracteres)</label>
                        <input type="password" id="reg-password" required placeholder="••••••••" class="w-full bg-dark-900 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-brand-500 text-sm">
