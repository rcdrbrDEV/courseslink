    <!-- Live Checkout Modal -->
    <div id="checkout-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="glass-card max-w-md w-full rounded-2xl p-8 border border-slate-700 relative">
            <button onclick="closeModal('checkout-modal')" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
            <div id="checkout-content">
                <!-- Dynamically loaded checkout -->
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-slate-800 border border-slate-700 text-white px-6 py-3 rounded-xl shadow-2xl flex items-center gap-3">
        <i data-lucide="check-circle" class="w-5 h-5 text-brand-500"></i>
        <span id="toast-msg" class="text-sm font-medium">Ação realizada com sucesso!</span>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, createUserWithEmailAndPassword, signInWithEmailAndPassword, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, getDoc, setDoc, updateDoc, deleteDoc, onSnapshot, collection, query, addDoc, getDocs } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};
        const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        const auth = getAuth(app);

        let currentUser = null;
        let allProducts = [];
        let creatorSubscribers = [];

        // Global functions exposed to window
        window.switchView = switchView;
        window.openModal = openModal;
        window.closeModal = closeModal;
        window.toggleAuthForm = toggleAuthForm;
        window.handleEmailLogin = handleEmailLogin;
        window.handleEmailRegister = handleEmailRegister;
        window.handleLogout = handleLogout;
        window.openCreateProductModal = openCreateProductModal;
        window.handleCreateProduct = handleCreateProduct;
        window.openCheckoutModal = openCheckoutModal;
        window.simulatePurchase = simulatePurchase;
        window.showToast = showToast;
        window.toggleMobileMenu = toggleMobileMenu;

        // Initialize Authentication
        async function initAuth() {
            try {
                if (initialAuthToken) {
                    await signInWithCustomToken(auth, initialAuthToken);
                } else {
                    await signInAnonymously(auth);
                }
            } catch (e) {
                console.error("Auth error:", e);
                try {
                    await signInAnonymously(auth);
                } catch (err) {
                    console.error("Anonymous auth error:", err);
                }
            }
        }

        initAuth().then(() => {
            onAuthStateChanged(auth, (user) => {
                currentUser = user;
                updateAuthUI(user);
                if (user) {
                    listenToProducts();
                    if (!user.isAnonymous) {
                        listenToCreatorSubscribers(user.uid);
                    }
                }
            });
        });

        function updateAuthUI(user) {
            const guestControls = document.getElementById('auth-guest-controls');
            const userControls = document.getElementById('auth-user-controls');
            const emailDisplay = document.getElementById('user-email-display');
            const dashLink = document.getElementById('nav-dashboard-link');
            const mobileDashWrap = document.getElementById('mobile-dashboard-wrap');
            const mobileAuth = document.getElementById('mobile-auth-controls');

            if (user && !user.isAnonymous) {
                guestControls.classList.add('hidden');
                userControls.classList.remove('hidden');
                emailDisplay.textContent = user.email;
                dashLink.classList.remove('hidden');
                mobileDashWrap.classList.remove('hidden');
                mobileAuth.innerHTML = `<button onclick="handleLogout()" class="w-full text-center py-2.5 text-rose-400 font-semibold border border-rose-500/30 rounded-xl bg-rose-500/10">Sair</button>`;
            } else {
                guestControls.classList.remove('hidden');
                userControls.classList.add('hidden');
                dashLink.classList.add('hidden');
                mobileDashWrap.classList.add('hidden');
                mobileAuth.innerHTML = `
                    <button onclick="openModal('login'); toggleMobileMenu()" class="w-full text-center py-2.5 text-slate-300 font-semibold border border-slate-700 rounded-xl">Entrar</button>
                    <button onclick="openModal('register'); toggleMobileMenu()" class="w-full text-center py-2.5 text-white gradient-bg font-semibold rounded-xl">Criar Conta Grátis</button>
                `;
            }
        }

        async function handleEmailLogin(e) {
            e.preventDefault();
            const email = document.getElementById('login-email').value;
            const pass = document.getElementById('login-password').value;
            try {
                await signInWithEmailAndPassword(auth, email, pass);
                closeModal('auth-modal');
                showToast('Login realizado com sucesso!');
                switchView('dashboard');
            } catch (err) {
                showToast('Erro ao entrar: ' + err.message);
            }
        }

        async function handleEmailRegister(e) {
            e.preventDefault();
            const email = document.getElementById('reg-email').value;
            const pass = document.getElementById('reg-password').value;
            try {
                await createUserWithEmailAndPassword(auth, email, pass);
                closeModal('auth-modal');
                showToast('Conta criada com sucesso!');
                switchView('dashboard');
            } catch (err) {
                showToast('Erro ao cadastrar: ' + err.message);
            }
        }

        async function handleLogout() {
            try {
                await signOut(auth);
                await signInAnonymously(auth);
                showToast('Você saiu da conta.');
                switchView('home');
            } catch (err) {
                console.error(err);
            }
        }

        // Firestore Realtime Products Listener
        function listenToProducts() {
            const productsRef = collection(db, 'artifacts', appId, 'public', 'data', 'products');
            onSnapshot(productsRef, (snapshot) => {
                allProducts = [];
                snapshot.forEach(doc => {
                    allProducts.push({ id: doc.id, ...doc.data() });
                });
                renderMarketplace();
                renderCreatorDashboard();
            }, (error) => {
                console.error("Error loading products:", error);
            });
        }

        // Firestore Realtime Subscribers Listener
        function listenToCreatorSubscribers(userId) {
            const subsRef = collection(db, 'artifacts', appId, 'users', userId, 'subscribers');
            onSnapshot(subsRef, (snapshot) => {
                creatorSubscribers = [];
                snapshot.forEach(doc => {
                    creatorSubscribers.push({ id: doc.id, ...doc.data() });
                });
                renderCreatorDashboard();
            }, (error) => {
                console.error("Error loading subscribers:", error);
            });
        }

        async function handleCreateProduct(e) {
            e.preventDefault();
            if (!currentUser || currentUser.isAnonymous) {
                showToast('Você precisa estar logado com e-mail para criar produtos.');
                openModal('auth-modal');
                return;
            }

            const title = document.getElementById('prod-title').value;
            const price = parseFloat(document.getElementById('prod-price').value);
            const platform = document.getElementById('prod-platform').value;
            const description = document.getElementById('prod-desc').value;

            try {
                const productsRef = collection(db, 'artifacts', appId, 'public', 'data', 'products');
                await addDoc(productsRef, {
                    title,
                    price,
                    platform,
                    description,
                    creatorId: currentUser.uid,
                    creatorEmail: currentUser.email,
                    createdAt: new Date().toISOString()
                });
                closeModal('product-modal');
                document.getElementById('prod-title').value = '';
                document.getElementById('prod-price').value = '';
                document.getElementById('prod-desc').value = '';
                showToast('Produto publicado com sucesso!');
                renderCreatorDashboard();
            } catch (err) {
                showToast('Erro ao publicar: ' + err.message);
            }
        }

        async function simulatePurchase(productId, productTitle, price, creatorId) {
            const buyerName = prompt("Digite seu nome completo para simular a compra:") || "Cliente Anônimo";
            const buyerEmail = prompt("Digite seu e-mail:") || "cliente@exemplo.com";

            try {
                const subsRef = collection(db, 'artifacts', appId, 'users', creatorId, 'subscribers');
                await addDoc(subsRef, {
                    productId,
                    productTitle,
                    price,
                    buyerName,
                    buyerEmail,
                    status: 'Ativo',
                    date: new Date().toISOString()
                });
                closeModal('checkout-modal');
                showToast(`Parabéns! Assinatura de "${productTitle}" realizada com sucesso.`);
            } catch (err) {
                showToast('Erro na compra: ' + err.message);
            }
        }

        // UI View Controller
        function switchView(viewName) {
            document.getElementById('view-home').classList.add('hidden');
            document.getElementById('view-marketplace').classList.add('hidden');
            document.getElementById('view-dashboard').classList.add('hidden');

            if (viewName === 'home') {
                document.getElementById('view-home').classList.remove('hidden');
            } else if (viewName === 'marketplace') {
                document.getElementById('view-marketplace').classList.remove('hidden');
                renderMarketplace();
            } else if (viewName === 'dashboard') {
                if (!currentUser || currentUser.isAnonymous) {
                    showToast('Faça login para acessar o painel do criador.');
                    openModal('auth-modal');
                    return;
                }
                document.getElementById('view-dashboard').classList.remove('hidden');
                renderCreatorDashboard();
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function renderMarketplace() {
            const grid = document.getElementById('marketplace-grid');
            if (!grid) return;

            if (allProducts.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full text-center py-20 text-slate-400">
                        <i data-lucide="folder-open" class="w-12 h-12 mx-auto mb-3 opacity-40"></i>
                        <p class="text-lg font-medium">Nenhuma comunidade cadastrada ainda.</p>
                        <p class="text-sm mt-1">Seja o primeiro a publicar sua comunidade!</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            grid.innerHTML = allProducts.map(p => `
                <div class="glass-card rounded-2xl p-6 border border-slate-800 flex flex-col justify-between hover:border-brand-500/50 transition-all">
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <span class="text-xs bg-brand-500/10 text-brand-400 font-semibold px-2.5 py-1 rounded-full border border-brand-500/20">${p.platform}</span>
                            <span class="text-xs text-slate-500">Por ${p.creatorEmail || 'Criador'}</span>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-2">${p.title}</h3>
                        <p class="text-slate-400 text-sm mb-6 line-clamp-3">${p.description}</p>
                    </div>
                    <div>
                        <div class="flex items-baseline gap-1 mb-4">
                            <span class="text-xs text-slate-400">R$</span>
                            <span class="text-2xl font-extrabold text-white">${Number(p.price).toFixed(2)}</span>
                            <span class="text-xs text-slate-400">/mês</span>
                        </div>
                        <button onclick='openCheckoutModal(${JSON.stringify(p)})' class="w-full py-3 rounded-xl gradient-bg text-white font-bold text-sm shadow-md hover:opacity-90 flex items-center justify-center gap-2">
                            Assinar Comunidade
                            <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            `).join('');
            lucide.createIcons();
        }

        function renderCreatorDashboard() {
            if (!currentUser || currentUser.isAnonymous) return;

            const myProducts = allProducts.filter(p => p.creatorId === currentUser.uid);
            document.getElementById('dash-prod-count').textContent = myProducts.length;
            document.getElementById('dash-sub-count').textContent = creatorSubscribers.length;

            const totalMrr = creatorSubscribers.reduce((acc, sub) => acc + Number(sub.price || 0), 0);
            document.getElementById('dash-mrr').textContent = totalMrr.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

            // Render Products List
            const prodList = document.getElementById('creator-products-list');
            if (myProducts.length === 0) {
                prodList.innerHTML = `<div class="glass-card p-6 rounded-xl text-slate-400 text-sm">Você ainda não cadastrou nenhum produto.</div>`;
            } else {
                prodList.innerHTML = myProducts.map(p => `
                    <div class="glass-card p-5 rounded-xl border border-slate-800 flex justify-between items-center">
                        <div>
                            <h4 class="font-bold text-white">${p.title}</h4>
                            <p class="text-xs text-slate-400 mt-0.5">${p.platform} • R$ ${Number(p.price).toFixed(2)}/mês</p>
                        </div>
                        <button onclick="copyCheckoutLink('${p.id}')" class="text-xs bg-slate-800 hover:bg-slate-700 text-brand-400 px-3 py-2 rounded-lg border border-slate-700 flex items-center gap-1">
                            <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            Copiar Link
                        </button>
                    </div>
                `).join('');
            }

            // Render Subscribers List
            const subList = document.getElementById('creator-subscribers-list');
            if (creatorSubscribers.length === 0) {
                subList.innerHTML = `<div class="glass-card p-6 rounded-xl text-slate-400 text-sm">Nenhum assinante registrado ainda.</div>`;
            } else {
                subList.innerHTML = creatorSubscribers.map(s => `
                    <div class="glass-card p-4 rounded-xl border border-slate-800 flex justify-between items-center text-sm">
                        <div>
                            <div class="font-bold text-white">${s.buyerName}</div>
                            <div class="text-xs text-slate-400">${s.productTitle} • ${s.buyerEmail}</div>
                        </div>
                        <span class="text-xs bg-brand-500/10 text-brand-400 font-semibold px-2.5 py-1 rounded-full">R$ ${Number(s.price).toFixed(2)}</span>
                    </div>
                `).join('');
            }
            lucide.createIcons();
        }

        function openCheckoutModal(product) {
            const modalContent = document.getElementById('checkout-content');
            modalContent.innerHTML = `
                <h3 class="text-2xl font-bold text-white mb-1">${product.title}</h3>
                <p class="text-xs text-slate-400 mb-6">Acesso automatizado via <span class="text-white font-semibold">${product.platform}</span></p>

                <div class="bg-dark-900 rounded-xl p-4 mb-6 border border-slate-800">
                    <div class="text-xs text-slate-400">Plano Mensal Recorrente</div>
                    <div class="flex items-baseline gap-1 mt-1">
                        <span class="text-sm font-semibold text-brand-500">R$</span>
                        <span class="text-3xl font-extrabold text-white">${Number(product.price).toFixed(2)}</span>
                        <span class="text-xs text-slate-400">/mês</span>
                    </div>
                </div>

                <p class="text-xs text-slate-300 mb-6 leading-relaxed">${product.description}</p>

                <button onclick="simulatePurchase('${product.id}', '${product.title}', ${product.price}, '${product.creatorId}')" class="w-full py-3.5 rounded-xl gradient-bg text-white font-bold text-sm shadow-lg shadow-brand-500/30 flex items-center justify-center gap-2 hover:opacity-90">
                    Confirmar Assinatura (PIX / Cartão)
                    <i data-lucide="lock" class="w-4 h-4"></i>
                </button>
                <div class="text-center text-[10px] text-slate-500 mt-3">Transação segura processada em nuvem</div>
            `;
            document.getElementById('checkout-modal').classList.remove('hidden');
            lucide.createIcons();
        }

        function copyCheckoutLink(prodId) {
            const link = `${window.location.origin}${window.location.pathname}#prod-${prodId}`;
            document.execCommand('copy');
            showToast('Link do produto copiado para a área de transferência!');
        }

        // Modals & UI Helpers
        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        function openCreateProductModal() {
            if (!currentUser || currentUser.isAnonymous) {
                showToast('Faça login com e-mail para cadastrar produtos.');
                openModal('auth-modal');
                return;
            }
            openModal('product-modal');
        }

        function toggleAuthForm(type) {
            if (type === 'login') {
                document.getElementById('form-login').classList.remove('hidden');
                document.getElementById('form-register').classList.add('hidden');
            } else {
                document.getElementById('form-login').classList.add('hidden');
                document.getElementById('form-register').classList.remove('hidden');
            }
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }

        // Lucide Icons initialization & Simulator logic
        lucide.createIcons();

        // Simulator inputs
        const simTitle = document.getElementById('sim-title');
        const simPrice = document.getElementById('sim-price');
        const simPlatform = document.getElementById('sim-platform');

        if (simTitle) {
            simTitle.addEventListener('input', (e) => {
                document.getElementById('preview-title').textContent = e.target.value || 'Sua Comunidade';
            });
            simPrice.addEventListener('input', (e) => {
                const val = parseFloat(e.target.value) || 0;
                document.getElementById('preview-price').textContent = val.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
            });
            simPlatform.addEventListener('change', (e) => {
                document.getElementById('preview-platform').textContent = e.target.value;
            });
        }

        // Earnings Calculator
        const membersInput = document.getElementById('members-input');
        const priceInput = document.getElementById('price-input');
        if (membersInput && priceInput) {
            function calculateRevenue() {
                const members = parseInt(membersInput.value);
                const price = parseFloat(priceInput.value);
                const total = members * price;
                document.getElementById('members-val').textContent = members;
                document.getElementById('price-val').textContent = `R$ ${price.toFixed(2)}`;
                document.getElementById('total-mrr').textContent = total.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            }
            membersInput.addEventListener('input', calculateRevenue);
            priceInput.addEventListener('input', calculateRevenue);
        }
    </script>
</body>
</html>
