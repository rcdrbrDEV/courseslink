                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-300 block mb-1">Plataforma</label>
                    <select id="prod-platform" class="w-full bg-dark-900 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-brand-500 text-sm">
                        <option value="Telegram VIP">Telegram (Automatizado)</option>
                        <option value="Grupo do WhatsApp">WhatsApp VIP</option>
                        <option value="Área de Membros">Área de Membros + Cursos</option>
                    </select>
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-300 block mb-1">Descrição</label>
                    <textarea id="prod-desc" rows="3" required placeholder="O que o assinante vai receber..." class="w-full bg-dark-900 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-brand-500 text-sm"></textarea>
                </div>
                <button type="submit" class="w-full py-3 rounded-xl gradient-bg text-white font-bold text-sm shadow-md hover:opacity-90">
