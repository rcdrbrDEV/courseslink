    <!-- Create Product Modal -->
    <div id="product-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="glass-card max-w-md w-full rounded-2xl p-8 border border-slate-700 relative">
            <button onclick="closeModal('product-modal')" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
            <h3 class="text-2xl font-bold text-white mb-2">Criar Novo Produto / VIP</h3>
