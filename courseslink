<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CoursesLink - Transforme sua audiência em um negócio recorrente</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            900: '#14532d',
                        },
                        dark: {
                            900: '#0B0F17',
                            800: '#111827',
                            700: '#1F2937',
                            600: '#374151'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .gradient-text {
            background: linear-gradient(135deg, #22c55e 0%, #10b981 50%, #3b82f6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .gradient-bg {
            background: linear-gradient(135deg, #16a34a 0%, #0d9488 100%);
        }
        .glass-card {
            background: rgba(17, 24, 39, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
    </style>
</head>
<body class="bg-dark-900 text-slate-100 antialiased selection:bg-brand-500 selection:text-white">

    <header class="fixed top-0 left-0 w-full z-50 border-b border-slate-800/80 bg-dark-900/80 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Logo -->
            <div class="flex items-center gap-3 cursor-pointer" onclick="switchView('home')">
                <div class="w-10 h-10 rounded-xl gradient-bg flex items-center justify-center font-black text-xl text-white shadow-lg shadow-brand-500/20">
                    C
                </div>
                <span class="text-2xl font-extrabold tracking-tight text-white">Courses<span class="text-brand-500">Link</span></span>
            </div>

            <!-- Desktop Navigation -->
            <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
                <a href="#recursos" onclick="switchView('home')" class="hover:text-brand-500 transition-colors">Recursos</a>
                <a href="#calculadora" onclick="switchView('home')" class="hover:text-brand-500 transition-colors">Calculadora</a>
                <a href="#marketplace" onclick="switchView('marketplace')" class="hover:text-brand-500 transition-colors">Comunidades</a>
                <div id="nav-dashboard-link" class="hidden">
                    <button onclick="switchView('dashboard')" class="hover:text-brand-500 transition-colors font-semibold text-brand-400">Meu Painel</button>
                </div>
            </nav>

            <!-- Action Buttons / Auth State -->
            <div class="hidden md:flex items-center gap-4">
                <div id="auth-guest-controls" class="flex items-center gap-3">
                    <button onclick="openModal('login')" class="text-sm font-semibold text-slate-300 hover:text-white transition-colors px-4 py-2">
                        Entrar
                    </button>
                    <button onclick="openModal('register')" class="text-sm font-semibold text-white gradient-bg hover:opacity-90 transition-all duration-200 px-5 py-2.5 rounded-xl shadow-lg shadow-brand-500/20 hover:scale-105">
                        Criar Conta Grátis
                    </button>
                </div>
                <div id="auth-user-controls" class="hidden flex items-center gap-3">
                    <span id="user-email-display" class="text-xs text-slate-400 bg-dark-800 px-3 py-1.5 rounded-lg border border-slate-700"></span>
                    <button onclick="handleLogout()" class="text-xs font-semibold bg-rose-500/10 text-rose-400 hover:bg-rose-500/20 transition-all px-3 py-2 rounded-xl border border-rose-500/30">
                        Sair
                    </button>
                </div>
            </div>

            <!-- Mobile Menu Button -->
            <button id="mobile-menu-btn" class="md:hidden text-slate-300 hover:text-white p-2">
                <i data-lucide="menu" class="w-6 h-6"></i>
            </button>
        </div>

        <!-- Mobile Menu Drawer -->
        <div id="mobile-menu" class="hidden md:hidden border-b border-slate-800 bg-dark-800 px-4 py-6 space-y-4">
            <a href="#recursos" onclick="switchView('home'); toggleMobileMenu()" class="block text-slate-300 hover:text-brand-500 font-medium">Recursos</a>
            <a href="#calculadora" onclick="switchView('home'); toggleMobileMenu()" class="block text-slate-300 hover:text-brand-500 font-medium">Calculadora</a>
            <a href="#marketplace" onclick="switchView('marketplace'); toggleMobileMenu()" class="block text-slate-300 hover:text-brand-500 font-medium">Comunidades</a>
            <div id="mobile-dashboard-wrap" class="hidden">
                <button onclick="switchView('dashboard'); toggleMobileMenu()" class="w-full text-left text-brand-400 font-semibold py-1">Meu Painel</button>
            </div>
            <div class="pt-4 border-t border-slate-700/50 flex flex-col gap-3" id="mobile-auth-controls">
                <button onclick="openModal('login'); toggleMobileMenu()" class="w-full text-center py-2.5 text-slate-300 font-semibold border border-slate-700 rounded-xl">Entrar</button>
                <button onclick="openModal('register'); toggleMobileMenu()" class="w-full text-center py-2.5 text-white gradient-bg font-semibold rounded-xl">Criar Conta Grátis</button>
            </div>
        </div>
    </header>

    <!-- Main View Container -->
    <main id="main-view" class="pt-20">
        <div id="view-home">
            <!-- Hero Section -->
            <section class="pt-12 pb-20 md:pt-28 md:pb-32 relative overflow-hidden">
                <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-500/10 rounded-full blur-[120px] pointer-events-none"></div>
                <div class="absolute top-1/3 right-10 w-[300px] h-[300px] bg-blue-500/10 rounded-full blur-[100px] pointer-events-none"></div>

                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                    <div class="text-center max-w-3xl mx-auto">
                        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-brand-500/30 bg-brand-500/10 text-brand-500 text-xs sm:text-sm font-semibold mb-8">
                            <span class="flex h-2 w-2 rounded-full bg-brand-500 animate-pulse"></span>
                            Servidor Ativo & Banco de Dados em Tempo Real
                        </div>
                        
                        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight mb-6">
                            Monetize seus conteúdos e comunidades <span class="gradient-text">no piloto automático</span>
                        </h1>
                        
                        <p class="text-lg sm:text-xl text-slate-400 mb-10 leading-relaxed font-normal">
                            Transforme seguidores em assinantes recorrentes no Telegram, WhatsApp e Cursos. Gerenciamento automatizado em nuvem.
                        </p>

                        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                            <button onclick="openModal('register')" class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold text-white gradient-bg shadow-xl shadow-brand-500/25 hover:shadow-brand-500/40 hover:scale-105 transition-all flex items-center justify-center gap-2">
                                Começar Agora Grátis
                                <i data-lucide="arrow-right" class="w-5 h-5"></i>
                            </button>
                            <button onclick="switchView('marketplace')" class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold text-slate-300 glass-card hover:bg-slate-800/80 transition-all text-center flex items-center justify-center gap-2">
                                <i data-lucide="compass" class="w-5 h-5 text-brand-500"></i>
                                Ver Comunidades Ativas
                            </button>
                        </div>

                        <!-- Proof Badges -->
                        <div class="mt-12 pt-8 border-t border-slate-800/80 grid grid-cols-2 md:grid-cols-4 gap-6 text-slate-400">
                            <div>
                                <div class="text-2xl sm:text-3xl font-extrabold text-white">+R$ 250M</div>
                                <div class="text-xs sm:text-sm mt-1">Processados em vendas</div>
                            </div>
                            <div>
                                <div class="text-2xl sm:text-3xl font-extrabold text-white">99.8%</div>
                                <div class="text-xs sm:text-sm mt-1">Uptime do servidor</div>
                            </div>
                            <div>
                                <div class="text-2xl sm:text-3xl font-extrabold text-white">+500k</div>
                                <div class="text-xs sm:text-sm mt-1">Assinantes em nuvem</div>
                            </div>
                            <div>
                                <div class="text-2xl sm:text-3xl font-extrabold text-white">0 R$</div>
                                <div class="text-xs sm:text-sm mt-1">Mensalidade fixa</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Interactive Demo / Checkout Preview -->
            <section id="demo" class="py-20 bg-dark-800/50 border-y border-slate-800/80">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center max-w-2xl mx-auto mb-16">
                        <h2 class="text-3xl font-bold text-white">Experiência sem atrito para seu cliente</h2>
                        <p class="text-slate-400 mt-3">Sua própria página de vendas otimizada para alta conversão em poucos cliques.</p>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                        <div class="lg:col-span-5 space-y-6">
                            <div class="glass-card p-6 rounded-2xl border border-slate-800">
                                <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
                                    <i data-lucide="sliders" class="w-5 h-5 text-brand-500"></i>
                                    Personalize sua oferta
                                </h3>
                                
                                <div class="space-y-4">
                                    <div>
                                        <label class="text-xs font-semibold uppercase tracking-wider text-slate-400 block mb-2">Nome da comunidade</label>
                                        <input type="text" id="sim-title" value="Clube VIP de Investimentos" class="w-full bg-dark-900 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-brand-500 text-sm">
                                    </div>
                                    
                                    <div>
                                        <label class="text-xs font-semibold uppercase tracking-wider text-slate-400 block mb-2">Preço da Assinatura (R$/mês)</label>
                                        <input type="number" id="sim-price" value="49.90" class="w-full bg-dark-900 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-brand-500 text-sm">
                                    </div>

                                    <div>
                                        <label class="text-xs font-semibold uppercase tracking-wider text-slate-400 block mb-2">Plataforma de Acesso</label>
                                        <select id="sim-platform" class="w-full bg-dark-900 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-brand-500 text-sm">
                                            <option value="Telegram VIP">Telegram (Automatizado)</option>
                                            <option value="Grupo do WhatsApp">WhatsApp VIP</option>
                                            <option value="Área de Membros">Área de Membros + Cursos</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="lg:col-span-7">
                            <div class="bg-gradient-to-tr from-brand-500/20 to-blue-500/20 p-4 sm:p-8 rounded-3xl border border-slate-700/50">
                                <div class="max-w-md mx-auto bg-dark-900 rounded-2xl shadow-2xl overflow-hidden border border-slate-800">
                                    <div class="h-32 bg-slate-800 relative gradient-bg flex items-center justify-center text-slate-300">
                                        <i data-lucide="image" class="w-10 h-10 opacity-30"></i>
                                        <span class="absolute top-3 right-3 bg-dark-900/80 backdrop-blur text-xs px-2.5 py-1 rounded-full text-brand-500 font-semibold border border-brand-500/30">Checkout Oficial</span>
                                    </div>

                                    <div class="p-6">
                                        <h4 id="preview-title" class="text-xl font-bold text-white mb-2">Clube VIP de Investimentos</h4>
                                        <p class="text-xs text-slate-400 mb-4 flex items-center gap-1">
                                            <i data-lucide="shield-check" class="w-4 h-4 text-brand-500"></i>
                                            Acesso automático via <span id="preview-platform" class="text-white font-medium">Telegram VIP</span>
                                        </p>

                                        <div class="bg-dark-800 rounded-xl p-4 mb-6 border border-slate-800">
                                            <div class="text-xs text-slate-400">Plano Mensal</div>
                                            <div class="flex items-baseline gap-1 mt-1">
                                                <span class="text-sm font-semibold text-brand-500">R$</span>
                                                <span id="preview-price" class="text-3xl font-extrabold text-white">49,90</span>
                                                <span class="text-xs text-slate-400">/mês</span>
                                            </div>
                                        </div>

                                        <button onclick="showToast('Esta é uma simulação. Publique sua oferta no painel para aceitar pagamentos reais!')" class="w-full py-3.5 rounded-xl gradient-bg text-white font-bold text-sm shadow-lg shadow-brand-500/30 flex items-center justify-center gap-2 hover:opacity-90 transition-opacity">
                                            Assinar Agora
                                            <i data-lucide="lock" class="w-4 h-4"></i>
                                        </button>
                                        <div class="text-center text-[10px] text-slate-500 mt-3">Pagamento 100% Seguro em Servidor Nuvem</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Features Grid -->
            <section id="recursos" class="py-24 relative">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center max-w-3xl mx-auto mb-20">
                        <h2 class="text-xs font-bold text-brand-500 tracking-wider uppercase mb-2">Tudo em uma plataforma</h2>
                        <p class="text-3xl sm:text-4xl font-extrabold text-white">Automatize o que toma seu tempo</p>
                        <p class="text-slate-400 mt-4 text-lg">Esqueça o controle manual de planilhas. A CoursesLink gerencia todo o ciclo de vida dos seus membros em servidores seguros.</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        <div class="glass-card p-8 rounded-2xl border border-slate-800 hover:border-brand-500/50 transition-all group">
                            <div class="w-12 h-12 rounded-xl bg-brand-500/10 text-brand-500 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                                <i data-lucide="send" class="w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-3">Automação do Telegram</h3>
                            <p class="text-slate-400 text-sm leading-relaxed">
                                Adicione automaticamente novos assinantes e remova inadimplentes ou cancelados sem mover um único dedo.
                            </p>
                        </div>

                        <div class="glass-card p-8 rounded-2xl border border-slate-800 hover:border-brand-500/50 transition-all group">
                            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                                <i data-lucide="credit-card" class="w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-3">Checkout de Alta Conversão</h3>
                            <p class="text-slate-400 text-sm leading-relaxed">
                                Receba via PIX instantâneo e Cartão de Crédito com cobrança recorrente processada por servidor seguro.
                            </p>
                        </div>

                        <div class="glass-card p-8 rounded-2xl border border-slate-800 hover:border-brand-500/50 transition-all group">
                            <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-500 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                                <i data-lucide="video" class="w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-3">Área de Membros Própria</h3>
                            <p class="text-slate-400 text-sm leading-relaxed">
                                Organize seus módulos de vídeos, PDFs e conteúdos exclusivos em um ambiente intuitivo e em nuvem.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Earnings Calculator Section -->
            <section id="calculadora" class="py-20 bg-dark-800/80 border-y border-slate-800">
                <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="glass-card p-8 sm:p-12 rounded-3xl border border-slate-700/60 relative overflow-hidden">
                        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>

                        <div class="text-center max-w-xl mx-auto mb-10">
                            <h2 class="text-3xl font-extrabold text-white">Quanto você pode faturar?</h2>
                            <p class="text-slate-400 mt-2">Simule o potencial de receita recorrente da sua comunidade.</p>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                            <div class="space-y-6">
                                <div>
                                    <div class="flex justify-between text-sm font-semibold mb-2">
                                        <span class="text-slate-300">Número de Assinantes:</span>
                                        <span id="members-val" class="text-brand-500 font-bold">250</span>
                                    </div>
                                    <input type="range" id="members-input" min="10" max="2000" step="10" value="250" class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-brand-500">
                                </div>

                                <div>
                                    <div class="flex justify-between text-sm font-semibold mb-2">
                                        <span class="text-slate-300">Valor da Assinatura Mensal:</span>
                                        <span id="price-val" class="text-brand-500 font-bold">R$ 59,00</span>
                                    </div>
                                    <input type="range" id="price-input" min="10" max="500" step="5" value="59" class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-brand-500">
                                </div>
                            </div>

                            <div class="bg-dark-900/90 rounded-2xl p-6 border border-slate-700 text-center flex flex-col justify-center items-center">
                                <span class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Faturamento Estimado</span>
                                <div id="total-mrr" class="text-4xl sm:text-5xl font-black text-white my-3 gradient-text">
                                    R$ 14.750,00
                                </div>
                                <span class="text-xs text-slate-500">por mês em receita recorrente</span>
                                
                                <button onclick="openModal('register')" class="mt-6 w-full py-3 rounded-xl gradient-bg text-white font-bold text-sm shadow-md hover:opacity-90 transition-opacity">
                                    Começar a Faturar Hoje
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div id="view-marketplace" class="hidden py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-10 border-b border-slate-800 pb-6">
                <div>
                    <h1 class="text-3xl font-extrabold text-white">Comunidades & Produtos Ativos</h1>
                    <p class="text-slate-400 text-sm mt-1">Explore comunidades reais cadastradas por criadores na plataforma em tempo real.</p>
                </div>
                <button onclick="switchView('home')" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-4 py-2 rounded-xl transition-colors">
                    Voltar ao Início
                </button>
            </div>

            <div id="marketplace-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Dynamic products will be loaded here -->
            </div>
        </div>

        <div id="view-dashboard" class="hidden py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 border-b border-slate-800 pb-6">
                <div>
                    <h1 class="text-3xl font-extrabold text-white">Painel do Criador</h1>
                    <p class="text-slate-400 text-sm mt-1">Gerencie suas comunidades, acompanhe vendas reais e crie novos produtos.</p>
                </div>
                <button onclick="openCreateProductModal()" class="gradient-bg text-white font-bold px-5 py-2.5 rounded-xl text-sm shadow-lg shadow-brand-500/20 flex items-center gap-2 hover:opacity-90">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    Criar Novo Produto / VIP
                </button>
            </div>

            <!-- Dashboard Stats Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-10">
                <div class="glass-card p-6 rounded-2xl border border-slate-800">
                    <div class="text-xs text-slate-400 uppercase font-semibold">Total de Produtos</div>
                    <div id="dash-prod-count" class="text-3xl font-extrabold text-white mt-2">0</div>
                </div>
                <div class="glass-card p-6 rounded-2xl border border-slate-800">
                    <div class="text-xs text-slate-400 uppercase font-semibold">Assinantes Ativos (Nuvem)</div>
                    <div id="dash-sub-count" class="text-3xl font-extrabold text-brand-500 mt-2">0</div>
                </div>
                <div class="glass-card p-6 rounded-2xl border border-slate-800">
                    <div class="text-xs text-slate-400 uppercase font-semibold">MRR Estimado</div>
                    <div id="dash-mrr" class="text-3xl font-extrabold text-emerald-400 mt-2">R$ 0,00</div>
                </div>
            </div>

            <!-- Creator Products & Subscribers Section -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <div class="lg:col-span-7 space-y-6">
                    <h2 class="text-xl font-bold text-white flex items-center gap-2">
                        <i data-lucide="package" class="w-5 h-5 text-brand-500"></i>
                        Seus Produtos Cadastrados
                    </h2>
                    <div id="creator-products-list" class="space-y-4">
                        <!-- Creator products populated here -->
                    </div>
                </div>

                <div class="lg:col-span-5 space-y-6">
                    <h2 class="text-xl font-bold text-white flex items-center gap-2">
                        <i data-lucide="users" class="w-5 h-5 text-brand-500"></i>
                        Últimas Assinaturas Registradas
                    </h2>
                    <div id="creator-subscribers-list" class="space-y-3">
                        <!-- Subscribers populated here -->
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="border-t border-slate-800/80 bg-dark-900 py-12 mt-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg gradient-bg flex items-center justify-center font-black text-white">
                        C
                    </div>
                    <span class="text-xl font-bold text-white">Courses<span class="text-brand-500">Link</span></span>
                </div>

                <div class="text-slate-500 text-xs text-center">
                    &copy; 2026 CoursesLink Cloud. Todos os direitos reservados. Servidor Ativo.
                </div>

